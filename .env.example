# Anthropic API key (required for AI analysis)
ANTHROPIC_API_KEY=

# CDP API keys (production facilitator — required for x402 v2)
# UUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CDP_API_KEY_ID=
# base64 format (ends with ==)
CDP_API_KEY_SECRET=

# x402 facilitator URL
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# EVM (Base) receiving wallet
WALLET_ADDRESS=0xC67d94504696960bA0f2e7C3FeE703950734c00A

# Solana receiving wallet
SOLANA_WALLET_ADDRESS=4s8XQC2WzRfgH8Xiep7ybnCW11VKRCMwxQF6jknx3VPf

# WalletConnect project ID (for RainbowKit)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Helius RPC URL (Solana)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Public app URL (used for x402 resource field)
NEXT_PUBLIC_APP_URL=https://your-vercel-url.vercel.app
